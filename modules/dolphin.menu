<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
 "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">

<!--
  Minimal XDG applications.menu.

  The stock Plasma applications.menu uses heavy OnlyUnallocated / category
  filtering that, on a non-Plasma session (here: Hyprland), can make KDE's
  menu + association builder mis-resolve the default handler so Dolphin shows
  the "open with" picker on double-click even when the default is set.

  This minimal menu just pulls in every desktop entry from the standard
  locations without that filtering, so KDE resolves the configured default
  (mimeapps.list) cleanly. Installed via:
    environment.etc."xdg/menus/applications.menu".source = ./modules/dolphin.menu;
-->
<Menu>
	<Name>Applications</Name>
	<Directory>kde-main.directory</Directory>

	<!-- Search the standard desktop-entry locations. -->
	<DefaultAppDirs/>
	<DefaultDirectoryDirs/>
	<DefaultMergeDirs/>

	<!-- Include everything; no category filtering. -->
	<Include>
		<All/>
	</Include>

	<DefaultLayout>
		<Merge type="menus"/>
		<Merge type="files"/>
	</DefaultLayout>
</Menu>
